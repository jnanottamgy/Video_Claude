# Secrets — never commit API keys
.env
.env.local

# Duplicate skill tree written by `npx skills add` for other agents.
# .agents/skills is the source of truth; .claude/skills symlinks into it.
/agent/

# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/
.npm/

# Video working output — raw footage and renders stay out of git
/edit/
*.mp4
*.mov
*.mkv
*.wav
*.mp3
!vendor/**/*.mp4

# Render/build artifacts
out/
dist/
.cache/

# Render outputs and frame sequences are reproducible from source (see each project's build script)
**/renders/
*.webm

# Reference stills of private rooms used only for placement previews
videos/shelf-wall-reveal/assets/reel-snapshot.png
