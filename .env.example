# Copy to .env and fill in what you need. .env is gitignored — never commit it.

# ElevenLabs — transcription (Scribe), voiceover, voice cloning, SFX.
# Required by: video-use (all transcription), elevenlabs skill.
# Get one: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- Optional: only needed for the toolkit's cloud generation skills ---

# RunPod — serverless cloud GPU (ltx2, qwen-edit, acestep, flux).
# https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# Ideogram — text-to-image with in-image text rendering.
# https://ideogram.ai
IDEOGRAM_API_KEY=

# Cloudflare R2 — asset storage for cloud render jobs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
